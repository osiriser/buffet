# Скопируйте этот файл в .env и подставьте свои значения.
# Файл .env в репозиторий не попадает (см. .gitignore).

# Токен бота от @BotFather
BOT_TOKEN=123456789:AA-your-telegram-bot-token

# Платёжный провайдер-токен (для теста подойдёт токен ЮKassa TEST).
# Получается через @BotFather -> Payments.
PAYMENT_TOKEN=381764678:TEST:00000

# Telegram user id администратора (узнать можно у @userinfobot)
ADMIN_ID=100000000
