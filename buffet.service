[Unit]
Description=Buffet Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/buffet
# Интерпретатор из виртуального окружения (Python 3.10–3.11)
ExecStart=/opt/buffet/.venv/bin/python /opt/buffet/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
